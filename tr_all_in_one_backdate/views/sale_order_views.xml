<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sale_order_backdate_form" model="ir.ui.view">
        <field name="name">sale.order.backdate.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@id='action_confirm']" position="before">
                <button name="action_backdate_wizard"
                        string="Set Backdate"
                        type="object"
                        class="btn-secondary"
                        invisible="state != 'draft'"/>
            </xpath>
            <xpath expr="//field[@name='date_order']" position="after">
                <field name="backdate" invisible="not backdate" readonly="1"/>
                <field name="backdate_remarks" invisible="not backdate_remarks" readonly="1"/>
            </xpath>
        </field>
    </record>

    <!-- Mass backdate server action -->
    <record id="action_sale_mass_backdate" model="ir.actions.server">
        <field name="name">Assign Backdate</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">
action = {
    'type': 'ir.actions.act_window',
    'name': 'Assign Backdate',
    'res_model': 'backdate.wizard',
    'view_mode': 'form',
    'target': 'new',
    'context': {
        'default_model': 'sale.order',
        'default_res_ids': records.ids,
    },
}
        </field>
    </record>

</odoo>
